generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @unique
  credit        Int
  creditrecords CreditRecord[]
}

model CreditRecord {
  id             String   @id @unique @default(uuid())
  userId         String
  change         Int
  currentBalance Int
  timestamp      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trivia {
  question    String   @unique
  explanation String
  id          Int      @id @unique @default(autoincrement())
  answers     Answer[]
}

model Answer {
  id       String  @id @unique @default(uuid())
  correct  Boolean
  emoji    String?
  text     String
  triviaId Int
  question Trivia  @relation(fields: [triviaId], references: [id], onDelete: Cascade)
}
