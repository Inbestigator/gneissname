generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       String  @id @unique
  credit   Int
  optedOut Boolean @default(false)

  creditrecords CreditRecord[]
  tracks        Tracking[]
}

model CreditRecord {
  id             String   @id @unique @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  change         Int
  currentBalance Int
  timestamp      DateTime @default(now())
}

model Tracking {
  id        String   @id @unique @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  timestamp DateTime @default(now())
}

model Trivia {
  id          Int      @id @unique @default(autoincrement())
  question    String   @unique
  explanation String
  answers     Answer[]
}

model Answer {
  id       String  @id @unique @default(uuid())
  triviaId Int
  question Trivia  @relation(fields: [triviaId], references: [id], onDelete: Cascade)
  correct  Boolean
  emoji    String?
  text     String
}

model Guesser {
  id    Int    @id @unique @default(autoincrement())
  image String @unique
  x     Int
  z     Int
}
